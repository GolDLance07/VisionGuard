# ==============================================================================
# VisionGuard — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# Note: If credentials are not provided or contain placeholders, VisionGuard
# automatically falls back to local SQLite and local storage without failing.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Create a free PostgreSQL database at https://neon.tech
# From your Neon Console dashboard, copy the pooled connection string:
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Cloudinary Media Storage for Critical Movement & Incident Snapshots
# ------------------------------------------------------------------------------
# Create a free account at https://cloudinary.com
# Method A (Recommended): Copy "API Environment variable" from your Cloudinary Dashboard:
# Example: CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz1@my-cloud-name
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# Method B (Optional alternative): Individual Cloudinary credentials:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 3. Server, Networking & Deployment
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
LOG_LEVEL=INFO
