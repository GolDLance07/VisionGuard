# ==============================================================================
# VisionGuard — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure in your deployment platform (e.g. Vercel, Netlify).
# In local development, the Vite dev server automatically proxies /api and /ws
# to http://localhost:8000 if these variables are left empty.
# ==============================================================================

# Backend API base URL (e.g., https://visionguard-backend.onrender.com or empty for local proxy)
VITE_API_URL=

# Backend WebSocket base URL (e.g., wss://visionguard-backend.onrender.com or empty for local proxy)
VITE_WS_URL=
